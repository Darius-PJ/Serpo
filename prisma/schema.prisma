datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  applications    Application[]
  resumeTemplates ResumeTemplate[]
  profileFields   ProfileField[]
  jobBoards       JobBoard[]
  jobBoardPins    JobBoardPin[]
}

model Application {
  id                  String    @id @default(cuid())
  // Nullable only so pre-multi-user rows aren't orphaned by the migration —
  // the first account ever registered claims every row still null here.
  // Never written as null going forward; every new row sets it at creation.
  userId              String?
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             String
  role                String
  source              String // "usajobs" | "adzuna" | "remoteok" | "jobspy" | "manual"
  url                 String?
  description         String? // job posting text captured at track time — feeds resume tailoring
  status              String    @default("Sourced") // Sourced | Submitted | Interviewing | Offer | Rejected | Withdrawn
  appliedAt           DateTime?
  lastStatusChangeAt  DateTime  @updatedAt
  followUpGeneratedAt DateTime? // guards the "only one 7-day follow-up" rule
  staleFlaggedAt      DateTime? // set when the 3-month no-update check first flags this row
  notes               String?
  decisionMakers      DecisionMaker[]
  messages            Message[]
  applyRuns           ApplyRun[]
  createdAt           DateTime  @default(now())

  @@unique([id, userId])
  @@index([userId])
}

model DecisionMaker {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String?
  title         String?
  email         String?
  sourceTool    String // "theharvester" etc.
  confidence    String? // raw tool signal, not a fabricated score
  foundAt       DateTime    @default(now())
}

model Message {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // "IMMEDIATE" | "FOLLOW_UP"
  draftText     String
  status        String      @default("DRAFT") // "DRAFT" | "APPROVED" | "SENT"
  createdAt     DateTime    @default(now())
  approvedAt    DateTime?
  sentAt        DateTime?
}

model JobBoard {
  id           String   @id @default(cuid())
  // Permanently nullable: null = curated/shared with every account forever;
  // non-null = privately added by that account ("manual" or "ai-discovered").
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  url          String
  jurisdiction String // "federal" | "state" | "municipal" | "other"
  region       String? // e.g. "CA", "Cook County IL"
  source       String   @default("curated") // "curated" | "ai-discovered" | "manual"
  // Only the default for user-owned boards. For curated (userId=null) boards,
  // pin state is per-account via JobBoardPin — this column is ignored for them.
  pinned       Boolean  @default(true)
  pins         JobBoardPin[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Per-account pin state for shared curated JobBoard rows — lets Account A
// unpin CalCareers without affecting Account B, since the JobBoard row itself
// is shared.
model JobBoardPin {
  id         String   @id @default(cuid())
  userId     String
  jobBoardId String
  pinned     Boolean
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobBoard   JobBoard @relation(fields: [jobBoardId], references: [id], onDelete: Cascade)

  @@unique([userId, jobBoardId])
}

model ResumeTemplate {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFilename String
  sourceFormat   String // "md" | "docx"
  contentText    String // extracted plain text — what tailoring actually reads
  createdAt      DateTime @default(now())

  @@unique([id, userId])
  @@index([userId])
}

model ProfileField {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // e.g. "email", "phone", "workAuthorization"
  label     String // the human-readable question, for display/audit
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@unique([id, userId])
}

model ApplyRun {
  id                  String      @id @default(cuid())
  applicationId       String
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status              String      @default("pending") // pending | needs_input | submitted | failed
  tailoredResumePath  String? // data/resumes/<id>.docx — git-ignored, local only
  formAnswersSnapshot String? // JSON: what was actually filled, for after-the-fact audit
  missingFieldKey     String? // set while status = needs_input — the ProfileField.key to save the answer under
  missingFieldLabel   String? // set while status = needs_input — human-readable question to show
  error               String?
  startedAt           DateTime  @default(now())
  submittedAt         DateTime?
}
