datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  applications    Application[]
  resumeTemplates ResumeTemplate[]
  profileFields   ProfileField[]
  jobBoards       JobBoard[]
  jobBoardPins    JobBoardPin[]
  resumeWorkspaces ResumeWorkspace[]
  raekwonReports  RaekwonReport[]
  auditEvents     AuditEvent[]
  titleAliases    TitleAlias[]
  tasks           Task[]
  contacts        Contact[]
  interactions    Interaction[]
}

// A person in the job search — recruiter, hiring manager, referral. Promoted
// from the old per-application DecisionMaker: user-scoped and reusable, so
// the same recruiter discovered on three applications is one record with one
// history. Merged on exact name+company within an account (user-approved);
// nameless discoveries never merge.
model Contact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String? // discovery tools sometimes return an email with no name
  title     String?
  email     String?
  company   String
  createdAt DateTime @default(now())

  applications ContactApplication[]
  interactions Interaction[]
  messages     Message[]

  @@unique([id, userId])
  @@index([userId, company])
}

// Which applications a contact was discovered on (or attached to), with the
// per-application provenance the old DecisionMaker row carried — kept here so
// merging contacts loses nothing.
model ContactApplication {
  id            String      @id @default(cuid())
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceTool    String // "hunter" | "manual" | ...
  confidence    String? // raw tool signal, not a fabricated score
  foundAt       DateTime    @default(now())

  @@unique([contactId, applicationId])
  @@index([applicationId])
}

// One touch with a contact — the relationship history a CRM exists to keep.
model Interaction {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // Optional: ties the touch to one application for the Phase 5 timeline. The
  // interaction is history with the person, so it outlives the application.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  kind          String // "email" | "call" | "linkedin" | "meeting" | "note"
  direction     String // "outbound" | "inbound"
  occurredAt    DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())

  @@unique([id, userId])
  @@index([userId])
  @@index([contactId, occurredAt])
  @@index([applicationId])
}

// A user-created next action — the only persisted kind of "to do". System
// signals (follow-ups due, stale checks, stuck apply runs) stay derived;
// only explicit user intent gets a row here.
model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional link: a task can hang off one application ("prep for the Acme
  // phone screen") or stand alone ("update resume").
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  dueAt         DateTime?
  completedAt   DateTime?
  snoozedUntil  DateTime? // hides the task from the attention queue until then
  createdAt     DateTime     @default(now())

  @@unique([id, userId])
  @@index([userId, completedAt])
  @@index([applicationId])
}

// User-curated "this title means my target role" equivalences, keyed by the
// normalized search keyword they apply to. Matching a user alias outranks an
// O*NET family match in search relevance (lib/jobSources/titleMatch.ts).
model TitleAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword   String // normalized (lowercase, punctuation stripped) search keyword
  alias     String // normalized alias title
  createdAt DateTime @default(now())

  @@unique([userId, keyword, alias])
  @@index([userId, keyword])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entityType String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Application {
  id                  String    @id @default(cuid())
  // Nullable only so pre-multi-user rows aren't orphaned by the migration —
  // the first account ever registered claims every row still null here.
  // Never written as null going forward; every new row sets it at creation.
  userId              String?
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             String
  role                String
  source              String // "usajobs" | "adzuna" | "remoteok" | "jobspy" | "manual"
  url                 String?
  description         String? // job posting text captured at track time — feeds resume tailoring
  status              String    @default("Sourced") // Sourced | Submitted | Interviewing | Offer | Rejected | Withdrawn
  appliedAt           DateTime?
  submissionState     String    @default("not_started") // not_started | review_required | needs_input | blocked | failed | confirmed | unknown
  submissionConfirmedAt DateTime?
  lastStatusChangeAt  DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  followUpGeneratedAt DateTime? // guards the "only one 7-day follow-up" rule
  staleFlaggedAt      DateTime? // set when the 3-month no-update check first flags this row
  staleReviewedAt     DateTime? // user acknowledged a stale row; re-review only after another 90 days
  notes               String?
  contactLinks        ContactApplication[]
  interactions        Interaction[]
  messages            Message[]
  applyRuns           ApplyRun[]
  tasks               Task[]
  createdAt           DateTime  @default(now())

  @@unique([id, userId])
  @@index([userId])
  @@index([userId, createdAt])
}

model Message {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // The contact this draft addresses, when one was chosen. The draft outlives
  // the contact record.
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type          String // "IMMEDIATE" | "FOLLOW_UP"
  draftText     String
  status        String      @default("DRAFT") // "DRAFT" | "APPROVED" | "SENT"
  createdAt     DateTime    @default(now())
  approvedAt    DateTime?
  sentAt        DateTime?
}

model JobBoard {
  id           String   @id @default(cuid())
  // Permanently nullable: null = curated/shared with every account forever;
  // non-null = privately added by that account ("manual" or "ai-discovered").
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  url          String
  jurisdiction String // "federal" | "state" | "municipal" | "other"
  region       String? // e.g. "CA", "Cook County IL"
  source       String   @default("curated") // "curated" | "ai-discovered" | "manual"
  // Only the default for user-owned boards. For curated (userId=null) boards,
  // pin state is per-account via JobBoardPin — this column is ignored for them.
  pinned       Boolean  @default(true)
  pins         JobBoardPin[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Per-account pin state for shared curated JobBoard rows — lets Account A
// unpin CalCareers without affecting Account B, since the JobBoard row itself
// is shared. Also carries per-account "search pool" status (for both curated
// and owned boards) so adding a board to live search never silently affects
// another account.
model JobBoardPin {
  id     String   @id @default(cuid())
  userId String
  jobBoardId String
  pinned Boolean
  // null = never attempted; "live" = a real connector was wired up and verified
  // (see integrationType); "browse-only" = URL verified reachable but not
  // live-searchable; "failed" = the verification attempt itself failed.
  poolStatus       String?
  integrationType  String? // "greenhouse" | "lever" | null
  integrationToken String? // board token extracted from the URL, only set when integrationType is set
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobBoard         JobBoard @relation(fields: [jobBoardId], references: [id], onDelete: Cascade)

  @@unique([userId, jobBoardId])
}

model ResumeTemplate {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFilename String
  sourceFormat   String // "md" | "docx"
  contentText    String // extracted plain text — what tailoring actually reads
  createdAt      DateTime @default(now())

  @@unique([id, userId])
  @@index([userId])
}

model ProfileField {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // e.g. "email", "phone", "workAuthorization"
  label     String // the human-readable question, for display/audit
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@unique([id, userId])
}

// The Resume tab — three illustrative resumes per job target, never the
// user's own résumé used for a real application:
//   benchmark = a fully-fictional "competitive benchmark" candidate
//   improved  = the user's own uploaded resume (ResumeTemplate), expanded
//               toward the target job
//   melded    = a hybrid of the two, an aspirational "growth target" resume
model ResumeWorkspace {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Both null = a "general" workspace, not tied to any job posting — the
  // Resume tab's default/landing state, showing only the Improved section.
  company        String?
  role           String?
  jobDescription String? // capped length, captured at creation time
  sourceUrl      String?
  // URL-encoded querystring (keywords/location/remoteOnly) snapshotting the
  // search that led here, so the tab's Back button can return to it.
  originSearchQuery String?

  benchmarkContent String? // JSON-serialized BenchmarkResume
  benchmarkStatus  String  @default("pending") // pending | generated | failed
  benchmarkError   String?

  improvedContent String? // JSON-serialized ImprovedResume
  improvedStatus  String  @default("not_started") // not_started | pending | generated | failed
  improvedError   String?

  meldedContent String? // JSON-serialized MeldedResume
  meldedStatus  String  @default("not_started") // not_started | pending | generated | failed
  meldedError   String?
  // Which two of "reference" | "improved" | "benchmark" produced meldedContent
  // — persisted so revisiting the workspace remembers the last combination.
  meldSourceA String?
  meldSourceB String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

// Raekwon — searches this app's own job-source connectors plus the live
// internet (Claude web_search) to "cook up" a curated batch of verified
// leads, more exploratory than the exact-match precision search in
// app/api/jobs/search/route.ts.
model RaekwonReport {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchSize          Int
  keyword            String
  location           String?
  jobType            String? // "full-time" | "contract" | null (either)
  compensationTarget String? // free text, e.g. "$120k+" or "$50/hr+" — advisory, not a hard filter
  sourcesHubMarkdown String?
  status             String   @default("pending") // pending | generated | failed
  error              String?
  createdAt          DateTime @default(now())
  leads              RaekwonLead[]

  @@unique([id, userId])
  @@index([userId])
}

model RaekwonLead {
  id                           String        @id @default(cuid())
  reportId                     String
  report                       RaekwonReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  company                      String
  roleTitle                    String
  jobType                      String // free text as stated/inferred (e.g. "Full-time", "Contract", "Unknown") — not a fixed enum
  location                     String?
  keyword                      String // the exact keyword or a close synonym/variation that surfaced this lead
  salaryOrRate                 String? // free text, only when actually stated somewhere — never estimate
  rank                         Int // 1-based rank within this batch, 1 = strongest fit
  explanation                  String // short note on why this is a strong prospect
  sourceUrl                    String
  duplicateVariantsSuppressed  String? // JSON-serialized array of { role_title, location, source_url } — near-duplicate postings of the same role, suppressed from separate listing
  createdAt                    DateTime      @default(now())

  @@index([reportId, rank])
}

model ApplyRun {
  id                  String      @id @default(cuid())
  applicationId       String
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status              String      @default("pending") // pending | review_required | needs_input | blocked | submitted | unknown | failed
  idempotencyKey      String?     @unique
  tailoredResumePath  String? // data/resumes/<applicationId>/<applyRunId>.docx — git-ignored, local only
  formAnswersSnapshot String? // JSON: what was actually filled, for after-the-fact audit
  submissionEvidence  String? // JSON: minimal confirmation signal or explicit user attestation
  missingFieldKey     String? // set while status = needs_input — the ProfileField.key to save the answer under
  missingFieldLabel   String? // set while status = needs_input — human-readable question to show
  error               String?
  startedAt           DateTime  @default(now())
  reviewedAt          DateTime?
  submittedAt         DateTime?
}

// Per-(source, search criteria) cache of raw normalized results, so a repeat
// search within the TTL skips the network call entirely. Global — the same
// external API call for the same criteria returns the same data for every
// account, so cache hits benefit the whole app, not just one user. Excluded
// from the per-account privacy wipe (lib/privacy/purge.ts) on purpose — this
// is shared infrastructure, not personal data, same as curated JobBoard rows.
model JobSourceCache {
  id           String   @id @default(cuid())
  source       String // connector key, or "greenhouse:<token>" / "lever:<token>" for pool boards
  criteriaHash String // sha256 of normalized {keywords, location, remoteOnly}
  listingsJson String // JSON-serialized NormalizedJobListing[]
  fetchedAt    DateTime @default(now())

  @@unique([source, criteriaHash])
}

// One row per listing ever seen, across all accounts. familyId +
// isRepresentative implement the dedup cluster: every listing in a family
// shares familyId, exactly one row per family has isRepresentative = true.
// Global, like JobSourceCache, for the same reason.
model JobListingFingerprint {
  id               String   @id @default(cuid())
  listingId        String   @unique // NormalizedJobListing.id, e.g. "adzuna:12345"
  familyId         String
  simhash          String // 64-bit fingerprint, hex
  contentHash      String // sha256 of role+description — detects a changed posting reusing the same listingId
  isAgency         Boolean // staffing-agency heuristic result, used for representative selection
  isRepresentative Boolean  @default(false)
  listingJson      String // full NormalizedJobListing snapshot, so the representative's data never needs re-fetching
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([familyId])
}
