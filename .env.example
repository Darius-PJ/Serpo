# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Local SQLite database file (relative to project root)
DATABASE_URL="file:./data/app.db"

# Claude API — used server-side only, never exposed to the browser
ANTHROPIC_API_KEY=

# Adzuna job search API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs API (https://developer.usajobs.gov/) — requires an email as User-Agent
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Path to a theHarvester installation (python -m theHarvester or a venv script).
# Leave unset to disable the decision-maker module.
THEHARVESTER_CMD="theHarvester"
