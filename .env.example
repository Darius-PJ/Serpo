# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Local SQLite database file (relative to project root)
DATABASE_URL="file:./data/app.db"

# Session signing secret for local multi-account auth (HS256 JWT). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Losing/rotating this logs everyone out (invalidates all existing session cookies).
AUTH_SECRET=

# Set to "true" only when this app is actually served over HTTPS. Leave blank/false
# for normal local usage — `next start -H 127.0.0.1` is plain HTTP, not TLS, and the
# session cookie's Secure flag would otherwise silently stop being sent.
COOKIE_SECURE=

# Claude API — used server-side only, never exposed to the browser
ANTHROPIC_API_KEY=

# Adzuna job search API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs API (https://developer.usajobs.gov/) — requires an email as User-Agent
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Jooble API — free instant self-serve signup, no card required (https://jooble.org/api/about).
# A broad aggregator-of-aggregators; skipped gracefully if left unset.
JOOBLE_API_KEY=

# Remotive, Himalayas, Jobicy, Arbeitnow, and RemoteOK need no API key — always on.
# JobSpy (LinkedIn/Indeed/Glassdoor/ZipRecruiter/Google) is also always on — note
# it's a scraper, and those sites' Terms of Service restrict automated access.
# Requires `pip install python-jobspy`; set JOBSPY_PYTHON if "python" isn't on PATH.
JOBSPY_PYTHON=

# Path to a theHarvester installation (python -m theHarvester or a venv script).
# Leave unset to disable the decision-maker module.
THEHARVESTER_CMD="theHarvester"

# Per-call timeout for job-source network requests (lib/jobSources/timeoutConfig.ts).
# A source that hangs past its timeout fails just that one source instead of
# hanging the whole search. JOBSPY_TIMEOUT_MS is separate and longer since
# JobSpy's subprocess scrapes five sites in one call. Both optional, sane
# defaults apply if left unset.
JOB_SOURCE_TIMEOUT_MS=15000
JOBSPY_TIMEOUT_MS=90000

# Job dedup + caching (lib/jobSources/dedupeConfig.ts). Both optional, sane
# defaults apply if left unset.
# DEDUP_SIMILARITY_THRESHOLD: 0-1 SimHash similarity (on title+description
# text) two postings must meet to be clustered as the same job. Default 0.90
# (90%) — raise it to only merge near-identical text, lower it to catch more
# loosely-reworded reposts at the risk of false merges.
DEDUP_SIMILARITY_THRESHOLD=0.90
# JOB_CACHE_TTL_MINUTES: how long a source's normalized results stay cached
# before a search re-fetches them. Default 15.
JOB_CACHE_TTL_MINUTES=15
