{
  "name": "serpo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/buildInstaller.ps1",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "verify:deployment": "node scripts/verifyDeploymentConfig.mjs",
    "db:upgrade-and-verify": "node scripts/dbUpgradeAndVerify.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run lint && tsc --noEmit && npm run verify:deployment && npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "mammoth": "^1.12.0",
    "next": "^16.3.4",
    "playwright": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "msw": "^2.15.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@prisma/engines": true,
    "prisma": true,
    "msw": true,
    "unrs-resolver": true
  }
}
