# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# generated Prisma client (regenerated via `npx prisma generate`)
/generated
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database — this app's entire dataset; never goes to git
/data/*.db
/data/*.db-journal
/data/resumes/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
